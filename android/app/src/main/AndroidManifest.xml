<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WiFi scanning (v1 core feature) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Required by Android for WiFi/BLE/GNSS scan results, not just GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Wi-Fi RTT/FTM ranging against 802.11mc-responder APs (see
         scan/FtmRangingManager.kt) — no extra runtime permission beyond
         ACCESS_FINE_LOCATION above, just the hardware capability. -->
    <uses-feature android:name="android.hardware.wifi.rtt" android:required="false" />

    <!-- Cellular serving/neighbor cell info -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Scanning a setup QR code in Settings (backend URL + sensor token) —
         see ui/SettingsScreen.kt. Requested on demand when the button is
         tapped, not at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- BLE device discovery. Two tiers, because BLUETOOTH_SCAN/_CONNECT
         only exist from API 31 — below that the adapter is gated by the
         legacy install-time permissions, and without them even reading
         BluetoothAdapter.isEnabled throws SecurityException. minSdk is 28,
         so dropping these crashes every pre-Android-12 device the moment
         the Scan tab probes BLE availability. maxSdkVersion keeps them off
         API 31+, where the runtime pair below supersedes them. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Enabling Bluetooth from the Scan tab (API 33+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Precision ranging enhancement tier (only used if both device and
         target support it; see ble/UwbLocateManager.kt) -->
    <uses-permission android:name="android.permission.UWB_RANGING" />

    <!-- Uploading scans to the self-hosted backend + LAN subnet scanning -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keeps a scan running (and visibly so, via the persistent
         notification) when the user switches tabs or backgrounds the app —
         see scan/ScanForegroundService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.uwb" android:required="false" />

    <application
        android:name=".WhyfiApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Whyfi">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for setup: a whyfi-setup:{json} link (or shared text
                 starting with "whyfi-setup:") opens the app and auto-configures
                 the backend URL + sensor token. The web UI can generate a
                 clickable link with the same payload as its QR code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="whyfi-setup" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".scan.ScanForegroundService"
            android:exported="false"
            android:foregroundServiceType="location|connectedDevice" />

    </application>
</manifest>
