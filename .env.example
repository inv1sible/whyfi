# Copy to .env and adjust before a real deployment. These defaults are meant
# to make `docker compose up` work out of the box for local/self-hosted use.

# --- Postgres ---
POSTGRES_DB=whyfi
POSTGRES_USER=whyfi
POSTGRES_PASSWORD=whyfi-dev-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Django ---
# Change this for any deployment reachable by anyone but you.
DJANGO_SECRET_KEY=change-me-insecure-dev-key-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# Port the backend container publishes; point your own reverse proxy here.
BACKEND_PORT=8000
# Required if you're reverse-proxying over HTTPS (e.g. Nginx Proxy Manager)
# — without it, logged-in POST requests (creating a sensor, triggering an
# Android build) fail with "CSRF Failed: Origin checking failed" because
# Django can't otherwise tell the original request was HTTPS. Set to your
# public URL(s), comma-separated, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://whyfi.yourdomain.tld
DJANGO_CSRF_TRUSTED_ORIGINS=

# Auto-create an admin user on first boot if it doesn't exist yet.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# Seed demo scan data so the dashboard isn't empty on first run.
LOAD_DEMO_DATA=true

# --- Android build/distribution ---
# Place a persistent release keystore at android/keystore/release.keystore
# (docker-compose bind-mounts that whole directory into android-builder).
# Generate it once; do NOT regenerate for an existing deployment — that
# breaks in-place app updates for anyone who already installed a build
# signed with the old key. See docs/deployment.md.
ANDROID_KEYSTORE_PASSWORD=change-me-keystore-password
ANDROID_KEY_ALIAS=whyfi
ANDROID_KEY_PASSWORD=change-me-key-password

# Baked into the app at build time as the pre-filled (still editable)
# backend URL on first launch — set to your public URL, same as
# DJANGO_CSRF_TRUSTED_ORIGINS above. Never put a token here; tokens are
# per-device and entered in the app itself, not baked into a shared APK.
WHYFI_PUBLIC_URL=
